{
	"name": "highscore-board",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"db:generate": "kysely-codegen --out-file src/server/database/database.gen.ts",
		"db:migrate": "dotenv -- kysely migrate up --experimental-resolve-tsconfig-paths",
		"dev": "vite dev",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"start": "node .output/server/index.mjs",
		"lint-staged": "lint-staged",
		"typecheck": "bun check"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.962.0",
		"@heroui/react": "^2.8.7",
		"@tanstack/react-form": "^1.27.7",
		"@tanstack/react-query": "^5.90.16",
		"@tanstack/react-query-devtools": "^5.91.2",
		"@tanstack/react-router": "^1.144.0",
		"@tanstack/react-router-devtools": "^1.144.0",
		"@tanstack/react-router-ssr-query": "^1.144.0",
		"@tanstack/react-start": "^1.145.3",
		"@trpc/client": "^11.8.1",
		"@trpc/server": "^11.8.1",
		"@trpc/tanstack-react-query": "^11.8.1",
		"cookie": "^1.1.1",
		"framer-motion": "^12.23.26",
		"i18next": "^25.7.3",
		"kysely": "^0.28.5",
		"pg": "^8.16.3",
		"pusher": "^5.2.0",
		"pusher-js": "8.4.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-i18next": "^16.5.1",
		"react-icons": "^5.5.0",
		"remeda": "^2.30.0",
		"sharp": "^0.34.5",
		"superjson": "^2.2.2",
		"tailwind-merge": "^3.3.1",
		"temporal-polyfill": "^0.3.0",
		"usehooks-ts": "^3.1.1",
		"uuid": "^11.1.0",
		"zod": "^4.3.4",
		"zod-form-data": "^3.0.1"
	},
	"devDependencies": {
		"@formatjs/intl-durationformat": "^0.9.0",
		"@luixo/configs": "0.1.0",
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/vite": "^4.1.11",
		"@tanstack/devtools-vite": "^0.4.0",
		"@tanstack/react-devtools": "^0.9.0",
		"@types/node": "^24.1.0",
		"@types/pg": "^8.15.5",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv-cli": "^10.0.0",
		"kysely-codegen": "^0.18.5",
		"kysely-ctl": "^0.17.0",
		"lint-staged": "^15.2.7",
		"nitro": "^3.0.1-alpha.1",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"pre-commit": "^2.0.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3",
		"vite": "8.3.4",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-tsconfig-paths": "^6.0.3"
	},
	"lint-staged": {
		"*.{j,t}s{,x}": [
			"oxlint --fix"
		]
	},
	"pre-commit": [
		"typecheck",
		"format",
		"lint-staged"
	],
	"engines": {
		"node": "26"
	},
	"packageManager": "bun@1.4.3",
	"trustedDependencies": [
		"pre-commit"
	]
}
